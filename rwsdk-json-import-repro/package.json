{
  "name": "rwsdk-json-import-repro",
  "version": "1.0.0",
  "description": "Reproduction: importing a JSON file (with or without ?raw) from both client and server bundles crashes the rwsdk dev server during directive scanning",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "pnpm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && pnpm run clean && pnpm run build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "pnpm run generate && pnpm run types",
    "types": "tsc"
  },
  "dependencies": {
    "capnweb": "0.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "rwsdk": "1.3.0-canary.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.39.0",
    "@cloudflare/workers-types": "4.20251109.0",
    "@types/node": "~24.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.2",
    "typescript": "5.8.3",
    "vite": "8.0.16",
    "wrangler": "4.99.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
